---
// Canvas stage for an athlete animation (see src/data/animations.ts).
// Scripts turn it into a scroll-scrubbed player via mountAthlete().
import { getAnimation, framePath } from '../data/animations';

interface Props {
  id: string;
  class?: string;
  eager?: boolean;
}

const { id, class: className = '', eager = false } = Astro.props;
const anim = getAnimation(id);
const focus = anim.kind === 'frames' ? (anim.focusX ?? 0.5) : 0.5;
const transparent = anim.kind === 'frames' && anim.transparent;
---

<div
  class:list={['athlete', `athlete--${anim.kind}`, { 'athlete--transparent': transparent }, className]}
  data-athlete={id}
  data-kind={anim.kind}
  data-count={anim.kind === 'frames' ? anim.count : undefined}
  data-focus={anim.kind === 'frames' ? focus : undefined}
  data-fit={transparent ? 'contain' : undefined}
  data-span={anim.kind === 'frames' && anim.span ? anim.span.join(',') : undefined}
  role="img"
  aria-label={anim.label}
>
  {anim.kind === 'frames' && (
    <img
      class="athlete__poster"
      src={framePath(id, 1)}
      alt=""
      width={anim.width}
      height={anim.height}
      style={transparent ? 'object-fit: contain' : `object-position: ${focus * 100}% 50%`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  )}
  {anim.kind === 'curve' ? (
    <svg class="athlete__curve" viewBox="0 0 100 100" aria-hidden="true">
      <line class="athlete__curve-base" x1="4" y1="54" x2="96" y2="54" />
      <path
        class="athlete__curve-path"
        pathLength="1"
        d="M 4 54 H 14 C 16 54 17 58 18.5 72 C 20.5 90 27.5 94 29.5 76 C 31.5 60 34 54 39 54 C 45 54 52.5 47 58.5 43 C 64.5 39 70 12 75 12 C 80 12 83.5 38 86.5 54 H 96"
      />
    </svg>
  ) : (
    <canvas class="athlete__canvas" aria-hidden="true"></canvas>
  )}
  {anim.kind === 'mocap' && <div class="mocap-hud" aria-hidden="true"></div>}
</div>
