---
import BrandIcon from './BrandIcon.astro';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const prefix = isHome ? '' : '/';
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <a href={`${prefix}#home`} class="brand-mark" aria-label="DNAthletic">
        <BrandIcon size={26} class="brand-icon-img" />
        <span>DNA<b>thletic</b></span>
      </a>
      <small>&copy; {year} DNAthletic. All rights reserved.</small>
    </div>

    <div class="footer-legal">
      <a href="/impressum" class="footer-link">Impressum</a>
      <a href="/datenschutz" class="footer-link">Privacy</a>
    </div>
  </div>
</footer>
