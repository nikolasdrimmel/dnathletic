---
import BrandIcon from './BrandIcon.astro';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const prefix = isHome ? '' : '/';
---

<footer class="site-footer">
  <div class="wrap">
    <a href={`${prefix}#hero`} class="brand-mark" style="display: inline-flex; align-items: center; gap: 0.65rem;" aria-label="DNAthletic">
      <BrandIcon size={24} class="brand-icon-img" />
      <span>DNA<b>thletic</b></span>
    </a>
    <nav aria-label="Footer Navigation">
      <a href={`${prefix}#hero`}>Home</a>
      <a href={`${prefix}#articles`}>Articles</a>
      <a href={`${prefix}#about`}>About</a>
      <a href={`${prefix}#impressum`}>Impressum</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <small>&copy; {year} DNAthletic. All rights reserved.</small>
  </div>
</footer>
