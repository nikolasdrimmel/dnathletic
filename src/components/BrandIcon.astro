---
interface Props {
  size?: number | string;
  class?: string;
}

const { size = 34, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Rounded Charcoal Background with Palette Warm Off-White Border -->
  <rect x="2.5" y="2.5" width="95" height="95" rx="22" fill="#111315" stroke="var(--c-ink)" stroke-width="4.5"/>
  
  <!-- Thick Zero Force Baseline -->
  <line
    x1="4"
    y1="54"
    x2="96"
    y2="54"
    stroke="var(--c-muted)"
    stroke-width="7"
    stroke-linecap="round"
    opacity="0.9"
  />
  <!-- Exact CMJ Force-Time Waveform -->
  <path
    d="M 4 54 H 14 C 16 54 17 58 18.5 72 C 20.5 90 27.5 94 29.5 76 C 31.5 60 34 54 39 54 C 45 54 52.5 47 58.5 43 C 64.5 39 70 12 75 12 C 80 12 83.5 38 86.5 54 H 96"
    stroke="var(--c-gold)"
    stroke-width="7.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
</svg>
