---
import BrandIcon from './BrandIcon.astro';

// Header with smooth anchor navigation for the one-page layout. On the
// homepage it starts transparent over the hero footage; src/scripts/home.ts
// toggles `is-over-hero` and highlights the active section link.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const prefix = isHome ? '' : '/';
---

<header class:list={['site-header', { 'is-over-hero': isHome }]}>
  <div class="wrap">
    <a href={`${prefix}#home`} class="brand" aria-label="DNAthletic home">
      <BrandIcon size={34} class="brand-icon-img" />
      <span>DNA<b>thletic</b></span>
    </a>

    <nav class="nav" aria-label="Primary Navigation">
      <a href={`${prefix}#home`} class:list={['nav-link', { active: isHome }]} data-nav="home">Home</a>
      <a href={`${prefix}#articles`} class="nav-link" data-nav="articles">Articles</a>
      <a href={`${prefix}#about`} class="nav-link" data-nav="about">About</a>
    </nav>
  </div>
</header>
