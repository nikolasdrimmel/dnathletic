---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="All Articles - DNAthletic"
  description="Essays and deep dives on strength, conditioning, and training technology."
>
  <section class="section">
    <div class="wrap wrap--narrow">
      <a href="/#articles" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back to homepage
      </a>

      <div class="section-head" style="margin-top: 1rem;">
        <h1 class="section-title">
          All Publications
        </h1>
        <span class="section-badge">{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
      </div>

      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-card">
              <div class="post-card-meta">
                <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
              </div>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-desc">{post.data.description}</p>
              <div class="post-card-footer">
                {post.data.tags.length > 0 ? (
                  <div class="tags">
                    {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                ) : <div />}
                <span class="read-more-arrow">
                  Read article
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
