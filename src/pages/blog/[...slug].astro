---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// ~220 words per minute, ignoring markup and LaTeX.
const words = (post.body ?? '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/\$\$[\s\S]*?\$\$|\$[^$\n]*\$/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 220));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="read-progress" aria-hidden="true"></div>

  <article class="article">
    <header class="article-hero">
      <div class="wrap wrap--editorial">
        <a href="/#articles" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          Back to all articles
        </a>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="article-subtitle article-subtitle--caps">{post.data.subtitle}</p>}
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>· Updated {fmtDate(post.data.updatedDate)}</span>}
          <span>· {readMinutes} min read</span>
        </div>
      </div>
    </header>

    <div class="wrap wrap--editorial">
      <div class="prose">
        <Content />
      </div>

      <div class="article-return" data-reveal>
        <a href="/#articles" class="btn btn--primary">Return to articles</a>
      </div>
    </div>
  </article>

  <script>
    import '../../scripts/article';
  </script>
</BaseLayout>
