---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <div class="wrap wrap--narrow">
      <a href="/blog" class="back-link">← All writing</a>

      <header class="article-header">
        <span class="kicker">{post.data.tags[0] ?? 'Notes'}</span>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <span>· updated {fmtDate(post.data.updatedDate)}</span>
          )}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <div class="tags" style="margin-top:2.5rem">
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </div>
  </article>
</BaseLayout>
