---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <div class="wrap wrap--narrow">
      <a href="/#articles" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back to all articles
      </a>

      <header class="article-header">
        <span class="kicker">
          <span class="kicker-dot"></span>
          {post.data.tags[0] ?? 'Article'}
        </span>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <span>· Updated {fmtDate(post.data.updatedDate)}</span>
          )}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <div class="tags" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--c-line);">
          {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}

      <div style="margin-top: 3.5rem; padding: 2rem; background: var(--c-panel); border: 1px solid var(--c-line); border-radius: var(--radius); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h4 style="font-size: 1.1rem; margin-bottom: 0.25rem;">DNAthletic Publication</h4>
          <p style="font-size: 0.9rem; color: var(--c-muted); margin: 0;">Explore more research, articles, and training tech breakdowns.</p>
        </div>
        <a href="/#articles" class="btn btn--primary">
          Browse All Articles
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
