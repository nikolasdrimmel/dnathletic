---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="DNAthletic - Science, Systems & Performance"
  description="A minimalist publication exploring strength science, conditioning, and training technology."
>
  <!-- 1. Presenting Dunk Video Hero Section -->
  <section id="home" class="hero-presentation">
    <div class="video-stage">
      <div class="video-ambient-glow" aria-hidden="true"></div>
      <div class="video-frame">
        <video
          src="/dunk.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="hero-video"
          aria-label="Basketball player performing a dunk"
        ></video>
      </div>
    </div>
  </section>

  <!-- 2. Articles Section (Swiss Editorial Index) -->
  <section id="articles" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Articles</h2>
        <span class="section-badge">{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
      </div>

      {posts.length > 0 ? (
        <div class="article-index">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="article-row">
              <div class="article-row-meta">
                <time class="article-row-date" datetime={post.data.pubDate.toISOString()}>
                  {fmtDate(post.data.pubDate)}
                </time>
                {post.data.tags.length > 0 && (
                  <span class="article-row-tag">{post.data.tags[0]}</span>
                )}
              </div>

              <div class="article-row-body">
                <h3 class="article-row-title">{post.data.title}</h3>
                <p class="article-row-desc">{post.data.description}</p>
              </div>

              <div class="article-row-action" aria-hidden="true">
                <span>Read</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-posts">
          <p>No articles published yet. Articles placed in <code>src/content/blog/</code> will appear here automatically.</p>
        </div>
      )}
    </div>
  </section>

  <!-- 3. About Me Section (Personal Profile) -->
  <section id="about" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">About Me</h2>
      </div>

      <div class="about-me">
        <div class="about-me__profile">
          <img
            src="/images/about/nikolas.png"
            alt="Nikolas Drimmel"
            class="about-me__photo"
            width="200"
            height="200"
            loading="lazy"
          />
          <div class="about-me__id">
            <span class="about-me__title">Sport Student</span>
            <span class="about-me__cred">B.Sc. Sport and Performance Student</span>
            <span class="about-me__cred">German Sports University Cologne</span>
          </div>
        </div>

        <div class="about-me__bio">
          <p>
            With <strong>DNAthletic</strong>, I want to provide a high-quality
            information source in Strength &amp; Conditioning for ambitious athletes
            and practitioners in these topics.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
