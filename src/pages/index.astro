---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="kicker">Strength · Conditioning · Technology</span>
          <h1>The science and systems behind getting strong.</h1>
          <p class="lede">
            DNAthletic breaks down strength &amp; conditioning — and the technology
            quietly rewriting how athletes train, recover, and measure progress.
          </p>
          <div class="hero-actions">
            <a href="#writing" class="btn btn--primary">Read the latest</a>
            <a href="/about" class="btn">About the project</a>
          </div>
        </div>

        <!-- Decorative double-helix -->
        <svg class="helix" width="120" height="260" viewBox="0 0 120 260" fill="none" aria-hidden="true">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M35 10C95 55 35 115 95 160C35 205 95 250 35 250" opacity="0.9" fill="none" />
            <path d="M95 10C35 55 95 115 35 160C95 205 35 250 95 250" opacity="0.55" fill="none" />
          </g>
          <g stroke="currentColor" stroke-width="2" opacity="0.35">
            <line x1="42" y1="30" x2="88" y2="30" />
            <line x1="55" y1="60" x2="65" y2="60" />
            <line x1="42" y1="90" x2="88" y2="90" />
            <line x1="55" y1="130" x2="65" y2="130" />
            <line x1="42" y1="160" x2="88" y2="160" />
            <line x1="55" y1="200" x2="65" y2="200" />
            <line x1="42" y1="230" x2="88" y2="230" />
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="wrap wrap--narrow">
      <div class="section-head">
        <h2>// latest writing</h2>
        <a href="/blog" class="back-link">All posts →</a>
      </div>

      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
            </div>
            <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
