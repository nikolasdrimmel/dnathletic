---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="DNAthletic - Science, Systems & Performance"
  description="A minimalist publication exploring strength science, conditioning, and training technology."
>
  <!-- 1. Presenting Dunk Video Hero Section -->
  <section id="hero" class="hero-presentation">
    <div class="video-stage">
      <div class="video-ambient-glow" aria-hidden="true"></div>
      <div class="video-frame">
        <video
          src="/dunk.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="hero-video"
          aria-label="Basketball player performing a dunk"
        ></video>
        <div class="video-vignette" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- 2. Articles Section (Swiss Editorial Index) -->
  <section id="articles" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Articles</h2>
        <span class="section-badge">{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
      </div>

      {posts.length > 0 ? (
        <div class="article-index">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="article-row">
              <div class="article-row-meta">
                <time class="article-row-date" datetime={post.data.pubDate.toISOString()}>
                  {fmtDate(post.data.pubDate)}
                </time>
                {post.data.tags.length > 0 && (
                  <span class="article-row-tag">{post.data.tags[0]}</span>
                )}
              </div>

              <div class="article-row-body">
                <h3 class="article-row-title">{post.data.title}</h3>
                <p class="article-row-desc">{post.data.description}</p>
              </div>

              <div class="article-row-action" aria-hidden="true">
                <span>Read</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-posts">
          <p>No articles published yet. Articles placed in <code>src/content/blog/</code> will appear here automatically.</p>
        </div>
      )}
    </div>
  </section>

  <!-- 3. About Section (Editorial Manifesto & Two Core Pillars) -->
  <section id="about" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">About DNAthletic</h2>
        <span class="section-badge">Mission &amp; Focus</span>
      </div>

      <div class="about-intro">
        DNAthletic is an independent notebook exploring the mechanics of human strength.
        The goal is to bridge empirical laboratory research with the practical realities of the barbell.
      </div>

      <div class="about-pillars">
        <div class="pillar-item">
          <h3 class="pillar-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18h12"/><path d="M6 6h12"/><path d="M18 12H6"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
            Strength &amp; Biomechanics
          </h3>
          <p class="pillar-desc">
            Deconstructing bar velocity, fatigue management, periodization models, and neuromuscular adaptations across compound movements.
          </p>
        </div>

        <div class="pillar-item">
          <h3 class="pillar-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Velocity &amp; Sensor Telemetry
          </h3>
          <p class="pillar-desc">
            Evaluating linear position transducers, force plates, and mathematical models to quantify load, readiness, and true velocity loss.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Impressum Section (Architectural Specs Grid) -->
  <section id="impressum" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Impressum</h2>
        <span class="section-badge">Legal &amp; Contact</span>
      </div>

      <div class="impressum-specs">
        <div class="spec-block">
          <span class="spec-label">Site Operator &amp; Publisher</span>
          <div class="spec-val">
            <strong>Nikolas Drimmel</strong><br />
            DNAthletic Project
          </div>
        </div>

        <div class="spec-block">
          <span class="spec-label">Direct Contact</span>
          <div class="spec-val">
            Email: <a href="mailto:contact@dnathletic.com">contact@dnathletic.com</a><br />
            Web: <a href="https://dnathletic.com">dnathletic.com</a>
          </div>
        </div>

        <div class="spec-block">
          <span class="spec-label">Publishing Format</span>
          <div class="spec-val">
            Occasional scientific essays, LaTeX mathematical derivations, and training technology analysis.
          </div>
        </div>
      </div>

      <p class="impressum-disclaimer">
        Disclaimer: The contents of this website are created for editorial and informational purposes. While care is taken to ensure scientific rigor, training decisions should always be adapted to individual capacities.
      </p>
    </div>
  </section>
</BaseLayout>
