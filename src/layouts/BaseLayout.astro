---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  preloadImage?: string; // above-the-fold image to fetch early (homepage hero frame)
}

const {
  title = 'DNAthletic',
  description = 'Strength, conditioning, and the technology behind how we train.',
  preloadImage,
} = Astro.props;

const fullTitle = title.includes('DNAthletic') ? title : `${title} - DNAthletic`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Disable mobile browser auto-translation prompts -->
    <meta name="google" content="notranslate" />
    <meta name="googlebot" content="notranslate" />

    <!-- Favicon & App Icons with explicit cache-busting -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260917" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20260917" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20260917" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260917" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260917" />
    <link rel="manifest" href="/site.webmanifest?v=20260917" />
    <meta name="theme-color" content="#111315" />

    <!-- RSS feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="DNAthletic" href="/rss.xml" />

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DNAthletic" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Typography: Outfit (Display), Inter (Prose), JetBrains Mono (Telemetry) — self-hosted -->
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- KaTeX math CSS for LaTeX rendering — self-hosted (matches installed katex 0.18.9) -->
    <link rel="stylesheet" href="/vendor/katex/katex.min.css" />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body class="notranslate">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Lenis smooth scroll + GSAP ScrollTrigger, anchor links, reveals -->
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
